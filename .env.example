WEB_ORIGIN=http://localhost:8080
FEED_INSTRUMENT_IDS=[]
HTTP_TIMEOUT_SECONDS=20
HTTP_RETRIES=3
HISTORY_CHUNK_DAYS=28
RECONCILE_SECONDS=60
MAX_SUBSCRIPTIONS=100
VOLUME_BASELINE_PERIOD=20
ABNORMAL_VOLUME_MULTIPLE=20

# Market data only; JSON list controls deterministic canonical precedence.
DEFAULT_MARKET_DATA_PROVIDER=upstox
PROVIDER_PREFERENCE=["upstox","sharekhan","hdfc_sky"]
ENABLE_UPSTOX=true
ENABLE_SHAREKHAN=false
ENABLE_HDFC_SKY=false
